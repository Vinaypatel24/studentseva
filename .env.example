# ==============================================================================
# StudentSeva Environment Configuration Template
# Copy this file to .env and populate with your own secret credentials.
# NEVER commit the actual .env file to GitHub.
# ==============================================================================

# Server Port
PORT=8080

# Database Configuration (Supabase PostgreSQL + PostGIS)
# Example: jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DB_URL=jdbc:postgresql://localhost:5432/studentseva
DB_USER=postgres
DB_PASSWORD=your_database_password_here

# JWT Authentication
# Generate with: openssl rand -base64 64
JWT_SECRET=your_super_secret_base64_jwt_key_at_least_256_bits_long_for_security

# Email Dispatch (Gmail SMTP for 6-Digit OTP)
# Generate App Password: Google Account -> Security -> 2-Step Verification -> App Passwords
MAIL_USERNAME=your_email@gmail.com
MAIL_APP_PASSWORD=your_16_character_app_password

# Cloudflare R2 Object Storage (Media & Photos)
R2_ENDPOINT=https://<your-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your_cloudflare_r2_access_key
R2_SECRET_ACCESS_KEY=your_cloudflare_r2_secret_key
R2_PUBLIC_URL=https://pub-<your-r2-hash>.r2.dev

# Google Gemini API Key (Natural Language AI Search)
GEMINI_API_KEY=your_google_ai_studio_api_key_here

# Frontend Application Origin (CORS Whitelist)
FRONTEND_URL=http://localhost:5173

